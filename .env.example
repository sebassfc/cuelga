# Copia este archivo a .env.local y llena los valores tú. Nunca subas .env.local.

# Proveedor: baseten (open weights, por defecto) | openrouter (open weights) | meta (Meta Model API)
CUELGA_PROVEEDOR=baseten
# Solo la key del proveedor elegido. Siempre del lado del servidor.
BASETEN_API_KEY=
OPENROUTER_API_KEY=
MODEL_API_KEY=

# Opcional: forzar IDs de modelo si `pnpm humo` dice que el de por defecto no existe.
# CUELGA_MODELO_CLASIFICADOR=meta-models/muse-spark-open
# CUELGA_MODELO_OIDO=meta-models/muse-spark-open

# Topes de gasto en USD que aplica el código (Meta y los proveedores solo avisan).
CUELGA_MAX_USD_PER_SESSION=0.50
CUELGA_MAX_USD_TOTAL=20
