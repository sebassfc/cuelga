{
  "name": "cuelga",
  "version": "0.1.0",
  "private": true,
  "description": "Cuelga: escudo contra el secuestro virtual. Built for the Meta Global AI Developer Hackathon (Oct 26 - Nov 4, 2026).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "humo": "tsx --env-file-if-exists=.env.local scripts/humo.ts",
    "eval": "tsx --env-file-if-exists=.env.local scripts/eval.ts",
    "voces": "tsx --env-file-if-exists=.env.local scripts/voces.ts"
  },
  "dependencies": {
    "next": "16.4.2",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "3.6.4",
    "fast-check": "4.10.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22"
  }
